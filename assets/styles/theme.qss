QMainWindow {
    background: #eef2f7;
}

QWidget#sidebar {
    background: white;
    border-right: 1px solid #d6dbe3;
}

QWidget#contentArea {
    background: #f7f9fc;
}

QLabel#logo {
    font-size: 42px;
}

QLabel#sidebarTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1f2937;
}

QLabel#pageTitle {
    font-size: 32px;
    font-weight: 700;
    color: #1f2937;
}

QLabel#pageSubtitle {
    font-size: 16px;
    color: #6b7280;
}
QPushButton#navigationButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    color: #374151;
}

QPushButton#navigationButton:hover {
    background: #e8eefc;
}

QPushButton#navigationButton:checked {
    background: #2563eb;
    color: white;
}