QMainWindow {
    background: #eef2f7;
}

QWidget#sidebar {
    background: white;
    border-right: 1px solid #d6dbe3;
}

QWidget#contentArea {
    background: #f7f9fc;
}

QLabel#logo {
    font-size: 42px;
}

QLabel#sidebarTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1f2937;
}

QLabel#pageTitle {
    font-size: 32px;
    font-weight: 700;
    color: #1f2937;
}

QLabel#pageSubtitle {
    font-size: 16px;
    color: #6b7280;
}